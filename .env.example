# =====================================================
# POS BRIKIN — Backend environment variables
# Copy this file to `.env` and adjust the values
# =====================================================

# HTTP server
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database
# DIALECT: mysql | postgres
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_brikin
DB_USER=root
DB_PASSWORD=

# Uploads (Multer)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Business rules
DEFAULT_TAX_RATE=0.05
DEFAULT_FX_RATE=2289.3077
LOW_STOCK_THRESHOLD=15
